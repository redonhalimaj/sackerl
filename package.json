{
  "name": "sackerl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @sackerl/web dev",
    "dev:mobile": "pnpm --filter @sackerl/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "pnpm --filter @sackerl/web typecheck",
    "typecheck:mobile": "pnpm --filter @sackerl/mobile typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css}\" \"README.md\" \"docs/environment.md\" \"docs/monorepo.md\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css}\" \"README.md\" \"docs/environment.md\" \"docs/monorepo.md\"",
    "code:map": "node scripts/update-code-map.mjs",
    "code:map:check": "node scripts/update-code-map.mjs --check",
    "db:status": "scripts/db.sh status",
    "db:plan": "scripts/db.sh plan",
    "db:push": "scripts/db.sh push",
    "db:new": "scripts/db.sh new"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15.5.28",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.4",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^5": "^5.0.12",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "compression": "^1.8.2",
      "decode-uri-component": "^0.5.1",
      "js-yaml": "^4.3.2",
      "node-forge": "^1.4.1",
      "postcss": "^8.5.23",
      "shell-quote": "^1.9.0",
      "source-map-js": "^1.2.2",
      "ws@^7": "^7.5.11",
      "ws@^8": "^8.21.0",
      "@babel/core": "^7.29.6",
      "@xmldom/xmldom@^0.8": "^0.8.15",
      "@xmldom/xmldom@^0.9": "^0.9.12",
      "nanoid@^3": "^3.3.18",
      "sharp": "^0.35.5",
      "image-size": "^2.0.3",
      "uuid@^7": "^11.1.1"
    }
  }
}
