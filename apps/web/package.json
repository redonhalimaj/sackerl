{
  "name": "@sackerl/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=api --project=smoke-mobile",
    "e2e:api": "playwright test --project=api",
    "e2e:smoke": "playwright test --project=smoke-mobile",
    "e2e:install": "playwright install chromium",
    "e2e:cleanup": "playwright test --project=cleanup"
  },
  "dependencies": {
    "@sackerl/api-client": "workspace:*",
    "@sackerl/tokens": "workspace:*",
    "@sackerl/ui": "workspace:*",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "16.4.7"
  }
}
