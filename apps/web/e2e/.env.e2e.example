# Copy to apps/web/e2e/.env.e2e (ignored). Names only; never commit values.
# Local Supabase (`supabase status`) is the default target.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Optional: web server URL (default http://127.0.0.1:3100, started automatically).
E2E_BASE_URL=
# Optional: comma-separated non-local hosts, only after owner approval. Production is always refused.
E2E_ALLOWED_SUPABASE_HOSTS=
# Optional: set to 1 to keep synthetic data after the run for debugging.
E2E_KEEP_DATA=
