{
  "description": "Add an item to the shopping list, check it, delete it.",
  "steps": [
    { "do": "open", "route": "/shopping-list" },
    { "do": "assertVisible", "id": "shopping-list.input", "timeout": 20000 },
    { "do": "type", "id": "shopping-list.input", "text": "E2E Oats" },
    { "do": "tap", "id": "shopping-list.add" },
    { "do": "assertVisible", "id": "shopping-list.row.*", "timeout": 15000 },
    { "do": "assertText", "text": "E2E Oats" },
    { "do": "screenshot", "name": "shopping-added" }
  ]
}
