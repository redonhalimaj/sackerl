{
  "description": "Simulated capture -> receipt review -> mark lines reviewed -> save -> Continue to placement stays disabled.",
  "steps": [
    { "do": "tap", "id": "tabs.scan" },
    { "do": "assertVisible", "id": "scan.screen" },
    { "do": "tap", "id": "scan.load-sample" },

    { "do": "assertVisible", "id": "receipt-review.lines", "timeout": 30000 },
    { "do": "screenshot", "name": "receipt-review" },
    { "do": "assertDisabled", "id": "receipt-review.continue-placement" },
    { "do": "tapIfPresent", "id": "receipt-review.line.0.mark-reviewed" },
    { "do": "tapIfPresent", "id": "receipt-review.line.1.mark-reviewed" },
    { "do": "tapIfPresent", "id": "receipt-review.line.2.mark-reviewed" },
    { "do": "tap", "id": "receipt-review.save" },
    { "do": "assertVisible", "id": "receipt-review.status", "timeout": 20000 },
    { "do": "screenshot", "name": "receipt-saved" },
    { "do": "assertDisabled", "id": "receipt-review.continue-placement" },
    { "do": "tap", "id": "receipt-review.done-for-now" },
    { "do": "assertVisible", "id": "home.screen" }
  ]
}
