{
  "description": "SCKRL-305 outcome-unknown retry. REQUIRES a separate run with EXPO_PUBLIC_APP_ENV=dev and EXPO_PUBLIC_E2E_PLACEMENT_FAULT=drop-first-response in the Metro env (dev-only hook, lib/placement-fault-injection.ts): the first finalize commits server-side but its response is dropped. The screen must claim neither success nor failure; Try again re-sends the same key and command, gets 'replayed', and lands on Home exactly once.",
  "steps": [
    {
      "do": "tap",
      "id": "tabs.scan"
    },
    {
      "do": "assertVisible",
      "id": "scan.screen"
    },
    {
      "do": "tap",
      "id": "scan.load-sample"
    },
    {
      "do": "assertVisible",
      "id": "receipt-review.lines",
      "timeout": 30000
    },
    {
      "do": "tapIfPresent",
      "id": "receipt-review.line.0.mark-reviewed"
    },
    {
      "do": "tapIfPresent",
      "id": "receipt-review.line.1.mark-reviewed"
    },
    {
      "do": "tapIfPresent",
      "id": "receipt-review.line.2.mark-reviewed"
    },
    {
      "do": "tap",
      "id": "receipt-review.save"
    },
    {
      "do": "assertVisible",
      "id": "receipt-review.status",
      "timeout": 20000
    },
    {
      "do": "assertEnabled",
      "id": "receipt-review.continue-placement"
    },
    {
      "do": "tap",
      "id": "receipt-review.continue-placement"
    },
    {
      "do": "assertVisible",
      "id": "receipt-placement.dock",
      "timeout": 30000
    },
    {
      "do": "assertDisabled",
      "id": "receipt-placement.submit"
    },
    {
      "do": "tap",
      "id": "receipt-placement.auto-sort"
    },
    {
      "do": "assertEnabled",
      "id": "receipt-placement.submit"
    },
    {
      "do": "tap",
      "id": "receipt-placement.submit"
    },
    {
      "do": "assertVisible",
      "id": "receipt-placement.outcome-unknown",
      "timeout": 30000
    },
    {
      "do": "assertNotVisible",
      "id": "receipt-placement.toast"
    },
    {
      "do": "assertNotVisible",
      "id": "receipt-placement.error"
    },
    {
      "do": "screenshot",
      "name": "placement-outcome-unknown"
    },
    {
      "do": "tap",
      "id": "receipt-placement.retry"
    },
    {
      "do": "assertVisible",
      "id": "home.screen",
      "timeout": 30000
    },
    {
      "do": "assertVisible",
      "id": "receipt-placement.toast"
    },
    {
      "do": "screenshot",
      "name": "placement-retry-home"
    }
  ]
}
